# Environment Variables for DZBoard
# Copy this file to .env and fill in your actual values

# ============ ADMIN CREDENTIALS ============
# MUST be set in production - no defaults!
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password_here
ADMIN_TOKEN=generate_a_long_random_token_here

# ============ SECURITY ============
# Secret key for signing cookies
COOKIE_SECRET=your_cookie_secret_key_change_this

# ============ FRONTEND ============
# Your frontend URL - restricts CORS
FRONTEND_URL=https://dzboard.vercel.app

# ============ DATABASE ============
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# ============ SHIPPING SERVICE ============
# Ecotrack API Configuration
ECOTRACK_API_URL=https://platform.dhd-dz.com/api/v1
ECOTRACK_API_TOKEN=your_ecotrack_api_token

# ============ ENVIRONMENT ============
# Set to 'production' for production deployment
NODE_ENV=development
